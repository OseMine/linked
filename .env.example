# ============================================
# Linked – Umgebungsvariablen (Vorlage)
# ============================================
# Kopiere diese Datei nach .env.local und fülle die Keys aus.
# .env.local ist per .gitignore ausgeschlossen.

# ------------------------------------------------------------
# Spotify (Client-Credentials) – für Song-Metadaten + ISRC
# ------------------------------------------------------------
# Erforderlich, damit Spotify-Links als Quelle ISRC & Cover liefern.
# 1. https://developer.spotify.com/dashboard -> Create App
# 2. Client-ID und Client-Secret kopieren
# 3. Dashboard -> Settings -> Redirect URIs -> http://localhost:3000 (ignoriert)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=